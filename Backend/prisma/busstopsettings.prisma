// For saving in settings
model BusStopSetting {
    id        String  @id @default(auto()) @map("_id") @db.ObjectId
    busStop   BusStop @relation(fields: [busStopId], references: [id], onDelete: Cascade)
    busStopId String  @db.ObjectId

    // Services saved for the bus stop. If empty, show all bus services.
    busServicesIDs String[]     @db.ObjectId

    settingSchemaGoingOut    SettingSchema? @relation("SettingsGoingOut", fields: [settingSchemaGoingOutId], references: [id])
    settingSchemaGoingHome   SettingSchema? @relation("SettingsGoingHome", fields: [settingSchemaGoingHomeId], references: [id])
    settingSchemaGoingOutId  String?        @db.ObjectId
    settingSchemaGoingHomeId String?        @db.ObjectId

    @@unique([busStopId, userId])

    userId     String  @db.ObjectId
}
