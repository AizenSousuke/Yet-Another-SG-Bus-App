model Setting {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    userId    String   @unique @db.ObjectId
    user      User     @relation(fields: [userId], references: [id])
    darkMode  Boolean  @default(false)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    settingsSchema SettingSchema?
}

model SettingSchema {
    id     String @id @default(auto()) @map("_id") @db.ObjectId
    userId String @unique @db.ObjectId

    goingOut  BusStopSetting[] @relation("SettingsGoingOut")
    goingHome BusStopSetting[] @relation("SettingsGoingHome")

    settingsId String  @unique @db.ObjectId
    settings   Setting @relation(fields: [settingsId], references: [id])
}
